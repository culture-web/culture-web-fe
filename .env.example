# Backend API (the backend mounts its routes under /api)
VITE_BACKEND_URI=http://localhost:3001/api

# Supabase browser client credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web3Forms access key used by the contact form (optional)
VITE_EMAIL_API_KEY=

# Never put a Supabase service-role key in this frontend file.
